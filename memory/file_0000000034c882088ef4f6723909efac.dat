from speech import listen
from router import process
from speech_engine import speak, stop, speaking
from personality import greeting

print("=" * 50)
print("          ULTRON 1.0 ALPHA")
print("=" * 50)

speak(greeting())

while True:

    # If Ultron is speaking and you talk,
    # stop speaking immediately.
    if speaking():
        stop()

    command = listen()

    if not command:
        continue

    print(f"\nHarsha: {command}")

    running, answer = process(command)

    if running is False:

        if answer:
            print(f"\nUltron: {answer}")
            speak(answer)

        break

    if answer:

        print(f"\nUltron: {answer}")

        speak(answer)