import random

GREETING = [
    "Welcome back, Harsha.",
    "Good to see you again, Harsha.",
    "I'm online, Harsha.",
    "Ready whenever you are.",
    "Systems online. Hello Harsha."
]

THINKING = [
    "Hmm...",
    "Hmmmmm...",
    "Interesting...",
    "Let me think...",
    "One moment..."
]

DONE = [
    "Done.",
    "Completed.",
    "Consider it done.",
    "Finished.",
    "It's ready."
]

ERROR = [
    "I couldn't do that.",
    "Something went wrong.",
    "I ran into an issue.",
    "That didn't work."
]


def greeting():
    return random.choice(GREETING)


def thinking():
    return random.choice(THINKING)


def done():
    return random.choice(DONE)


def error():
    return random.choice(ERROR)